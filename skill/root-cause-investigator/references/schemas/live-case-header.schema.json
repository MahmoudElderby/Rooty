{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rooty.dev/schemas/live-case-header.schema.json",
  "title": "Rooty live case header",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "state", "created_at", "project", "ticket", "host", "environment", "providers", "doctor", "capture_policy"],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "type": "string", "pattern": "^INV-[A-Z0-9-]+$" },
    "state": { "enum": ["OPEN", "EVIDENCE_COLLECTION", "ANALYSIS_SUBMITTED", "VERIFIED", "FINALIZED", "BLOCKED", "ABANDONED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "project": { "$ref": "#/$defs/project" },
    "ticket": { "$ref": "#/$defs/ticket" },
    "host": { "$ref": "#/$defs/host" },
    "environment": { "$ref": "#/$defs/environment" },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } },
    "doctor": { "$ref": "#/$defs/doctor" },
    "capture_policy": { "$ref": "#/$defs/capturePolicy" },
    "current_analysis_revision": { "type": "integer", "minimum": 1 },
    "blocked_reason": { "type": "string", "minLength": 1 },
    "abandoned_reason": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "project": { "type": "object", "additionalProperties": false, "required": ["name", "root_fingerprint"], "properties": { "name": { "type": "string", "minLength": 1 }, "root_fingerprint": { "$ref": "#/$defs/hash" } } },
    "ticket": { "type": "object", "additionalProperties": false, "required": ["id", "source"], "properties": { "id": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 } } },
    "host": { "type": "object", "additionalProperties": false, "required": ["id", "config_generation"], "properties": { "id": { "type": "string", "minLength": 1 }, "config_generation": { "$ref": "#/$defs/hash" } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["id", "profile_hash"], "properties": { "id": { "type": "string", "minLength": 1 }, "profile_hash": { "$ref": "#/$defs/hash" } } },
    "provider": { "type": "object", "additionalProperties": false, "required": ["instance_id", "capability", "configuration_hash", "allowlist_hash"], "properties": { "instance_id": { "type": "string", "minLength": 1 }, "capability": { "type": "string", "minLength": 1 }, "configuration_hash": { "$ref": "#/$defs/hash" }, "allowlist_hash": { "$ref": "#/$defs/hash" } } },
    "doctor": { "type": "object", "additionalProperties": false, "required": ["verified_at", "verification_hash"], "properties": { "verified_at": { "type": "string", "format": "date-time" }, "verification_hash": { "$ref": "#/$defs/hash" } } },
    "capturePolicy": { "type": "object", "additionalProperties": false, "required": ["max_capture_bytes", "max_model_visible_chars", "retention"], "properties": { "max_capture_bytes": { "type": "integer", "minimum": 1 }, "max_model_visible_chars": { "type": "integer", "minimum": 1 }, "retention": { "enum": ["case", "metadata-only", "none"] } } }
  }
}
