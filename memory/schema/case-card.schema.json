{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rooty.local/schema/case-card.schema.json",
  "type": "object",
  "required": [
    "schema_version", "case_id", "review_status", "services", "environments", "symptom_signature",
    "root_cause_class", "trigger_class", "useful_pivots", "query_recipes", "validated_versions",
    "evidence_refs", "source_case_status", "proposed_at", "source_case_fingerprint",
    "source_ledger_head", "source_ledger_count", "content_fingerprint", "scope", "kind",
    "canonical_key", "statement", "applicability", "supersedes", "proposed_disposition",
    "learning_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "case_id": { "type": "string", "pattern": "^INV-[A-Z0-9-]+$" },
    "review_status": { "enum": ["draft", "approved"] },
    "services": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "environments": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "symptom_signature": { "type": "object" },
    "root_cause_class": { "type": "string", "minLength": 1 },
    "trigger_class": { "type": "string", "minLength": 1 },
    "useful_pivots": { "type": "array", "items": { "type": "string" } },
    "query_recipes": { "type": "array", "items": { "type": "string" } },
    "validated_versions": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string", "pattern": "^E[0-9]+$" }, "minItems": 1 },
    "source_case_status": { "const": "CONFIRMED" },
    "proposed_at": { "type": "string", "format": "date-time" },
    "source_case_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_ledger_head": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_ledger_count": { "type": "integer", "minimum": 1 },
    "content_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "enum": ["universal", "project", "case_only"] },
    "kind": { "enum": ["method", "source_mapping", "query_recipe", "failure_pattern"] },
    "canonical_key": { "type": "string", "pattern": "^[a-z0-9]+([._:-][a-z0-9]+)*$" },
    "statement": { "type": "string", "minLength": 1 },
    "applicability": {
      "type": "object",
      "required": ["services", "environments", "validated_versions"],
      "properties": {
        "services": { "type": "array", "items": { "type": "string" } },
        "environments": { "type": "array", "items": { "type": "string" } },
        "validated_versions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "supersedes": { "type": "array", "items": { "type": "string", "pattern": "^INV-[A-Z0-9-]+$" } },
    "proposed_disposition": { "enum": ["upstream_proposal", "project_memory", "case_notes"] },
    "learning_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "review_status": { "const": "approved" } } },
      "then": { "required": ["reviewed_by", "reviewed_at", "expires_at"] }
    }
  ],
  "additionalProperties": false
}
