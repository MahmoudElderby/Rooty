{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rooty.dev/schemas/resource-inventory-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resources", "capability_bindings"],
  "properties": {
    "schema_version": { "const": 2 },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "capability_bindings": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["id", "kind", "provider", "service", "service_root", "environment", "confidence", "classification", "credential_references", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "kind": { "enum": ["database", "observability", "ticketing"] },
        "provider": { "enum": ["mssql", "elasticsearch", "jira"] },
        "service": { "type": "string" },
        "service_root": { "type": "string" },
        "environment": { "type": "string" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "classification": { "enum": ["DETECTED", "AI_SUGGESTED", "REPORTED"] },
        "credential_references": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }, "uniqueItems": true },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "signal"], "properties": { "path": { "type": "string" }, "signal": { "type": "string" } } } }
      }
    }
  }
}
