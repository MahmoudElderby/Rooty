{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rooty.dev/schemas/credential-requirements-v1.json",
  "type": "object",
  "required": ["schema_version", "requirements"],
  "properties": { "schema_version": { "const": 1 }, "requirements": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "connector", "required", "secret", "resolution"], "properties": { "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" }, "connector": { "type": "string" }, "required": { "type": "boolean" }, "secret": { "const": true }, "resolution": { "enum": ["environment", "host-oauth"] } } } } }
}
